# ==============================================================================
.venv/
/.uv/
/node_modules/
.pnp
.pnp.js

# ==============================================================================
# 2. Django / Python
# ==============================================================================
# Byte-compiled
__pycache__/
*.py[cod]
*$py.class

# Local configurations & databases
/local_settings.py
/db.sqlite3
/db.sqlite3-journal

# Media / Uploads
/media/
/static_root/

# Python Testing & Logs
.pytest_cache/
.coverage
htmlcov/
*.log

# Build & distributions
/dist/
/build/
*.egg-info/

# ==============================================================================
# 3. React SPA & Frontend Tools
# ==============================================================================
# Production builds
/frontend/dist/
/frontend/build/

# Frontend Logs & Testing
/frontend/coverage/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo

# ==============================================================================
# 4. Sensitive Environment Variables (Never Commit)
# ==============================================================================
.env
.env.local
.env.*.local
